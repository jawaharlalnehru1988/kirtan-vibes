{
  "name": "kirtan-vibes-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Kirtan Vibes: Next.js Frontend & Django REST Backend with Admin Panel",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "dev:backend": "powershell -Command \"cd backend; .\\venv\\Scripts\\python.exe manage.py runserver 8000\"",
    "migrate:backend": "powershell -Command \"cd backend; .\\venv\\Scripts\\python.exe manage.py migrate\"",
    "seed:backend": "powershell -Command \"cd backend; .\\venv\\Scripts\\python.exe seed_data.py\""
  },
  "keywords": [
    "nextjs",
    "django",
    "mridanga",
    "kirtan",
    "monorepo"
  ],
  "author": "Sri Ganapathi Prabhu / Kirtan Vibes",
  "license": "UNLICENSED"
}
